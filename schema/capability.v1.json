{
  "$defs": {
    "ActionType": {
      "enum": [
        "click",
        "type",
        "select",
        "press",
        "dismiss",
        "wait",
        "extract"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "CapabilityPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_hosts": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "allowed_actions": {
          "items": {
            "$ref": "#/$defs/ActionType"
          },
          "title": "Allowed Actions",
          "type": "array"
        },
        "irreversible_requires": {
          "default": "hitl",
          "enum": [
            "approval",
            "hitl",
            "block"
          ],
          "title": "Irreversible Requires",
          "type": "string"
        }
      },
      "required": [
        "allowed_hosts",
        "allowed_actions"
      ],
      "title": "CapabilityPolicy",
      "type": "object"
    },
    "Checkpoint": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "all_of": {
          "items": {
            "$ref": "#/$defs/Witness"
          },
          "title": "All Of",
          "type": "array"
        }
      },
      "required": [
        "description",
        "all_of"
      ],
      "title": "Checkpoint",
      "type": "object"
    },
    "ControlTarget": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "primary": {
          "$ref": "#/$defs/LocatorCandidate"
        },
        "fallbacks": {
          "items": {
            "$ref": "#/$defs/LocatorCandidate"
          },
          "title": "Fallbacks",
          "type": "array"
        },
        "witness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Witness"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rationale": {
          "default": "",
          "description": "Why this targeting should survive tenant branding and modest version drift.",
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "description",
        "primary"
      ],
      "title": "ControlTarget",
      "type": "object"
    },
    "EntryPoint": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/SurfaceKind",
          "default": "web"
        },
        "app_family": {
          "title": "App Family",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "launch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Launch"
        }
      },
      "required": [
        "app_family"
      ],
      "title": "EntryPoint",
      "type": "object"
    },
    "Handler": {
      "additionalProperties": false,
      "description": "Exceptional states live here, not in the happy-path step list.\n\nInterstitials that only appear on some visits must not be compiled as\nrequired steps \u2014 replay two would then fail when the notice is gone.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/HandlerMatch"
        },
        "then": {
          "enum": [
            "business_outcome",
            "recover",
            "fail",
            "escalate"
          ],
          "title": "Then",
          "type": "string"
        },
        "outcome_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome Code"
        },
        "recover": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoverAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        }
      },
      "required": [
        "id",
        "description",
        "when",
        "then"
      ],
      "title": "Handler",
      "type": "object"
    },
    "HandlerMatch": {
      "additionalProperties": false,
      "properties": {
        "text_contains": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Contains"
        },
        "url_glob": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url Glob"
        }
      },
      "title": "HandlerMatch",
      "type": "object"
    },
    "LocatorCandidate": {
      "additionalProperties": false,
      "description": "One way to find a control. Replay tries primary then fallbacks.",
      "properties": {
        "by": {
          "$ref": "#/$defs/LocatorStrategy"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "name_exact": {
          "default": true,
          "title": "Name Exact",
          "type": "boolean"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "near": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Near"
        },
        "css": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Css"
        },
        "nth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nth"
        },
        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Named frame/iframe, e.g. 'ws'. Desktop drivers ignore this.",
          "title": "Frame"
        },
        "html_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vendor control name (txtMemNo). Often stable across tenants of the same core.",
          "title": "Html Name"
        }
      },
      "required": [
        "by"
      ],
      "title": "LocatorCandidate",
      "type": "object"
    },
    "LocatorStrategy": {
      "enum": [
        "role",
        "near_text",
        "text",
        "css",
        "table"
      ],
      "title": "LocatorStrategy",
      "type": "string"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "discovery_run_id": {
          "title": "Discovery Run Id",
          "type": "string"
        },
        "compiler": {
          "default": "hands/0.1",
          "title": "Compiler",
          "type": "string"
        },
        "source": {
          "default": "discovery",
          "enum": [
            "discovery",
            "human_amended",
            "authored"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "discovery_run_id"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "OutputSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "number",
            "currency"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "sensitive": {
          "default": false,
          "title": "Sensitive",
          "type": "boolean"
        },
        "target": {
          "$ref": "#/$defs/ControlTarget"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional regex; first group or full match becomes the output value.",
          "title": "Pattern"
        }
      },
      "required": [
        "name",
        "type",
        "description",
        "target"
      ],
      "title": "OutputSpec",
      "type": "object"
    },
    "Parameter": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "number",
            "currency",
            "enum"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "sensitive": {
          "default": false,
          "title": "Sensitive",
          "type": "boolean"
        },
        "enum": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enum"
        },
        "example": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Example"
        }
      },
      "required": [
        "name",
        "type",
        "description"
      ],
      "title": "Parameter",
      "type": "object"
    },
    "RecoverAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "click",
          "default": "click",
          "title": "Action",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ControlTarget"
        }
      },
      "required": [
        "target"
      ],
      "title": "RecoverAction",
      "type": "object"
    },
    "RiskClass": {
      "enum": [
        "safe",
        "sensitive",
        "irreversible",
        "judgment"
      ],
      "title": "RiskClass",
      "type": "string"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/ActionType"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "parameter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bind this step's typed value to a parameter name. Mutually exclusive with literal value.",
          "title": "Parameter"
        },
        "extract_as": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extract As"
        },
        "risk": {
          "$ref": "#/$defs/RiskClass",
          "default": "safe"
        },
        "wait": {
          "$ref": "#/$defs/WaitPolicy"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "action"
      ],
      "title": "Step",
      "type": "object"
    },
    "SurfaceKind": {
      "enum": [
        "web",
        "desktop"
      ],
      "title": "SurfaceKind",
      "type": "string"
    },
    "TenantOverlay": {
      "additionalProperties": false,
      "description": "Per-institution specialization of a base capability.\n\nSame app_family, different branding. Overlays may replace locators;\nthey may not add actions or widen policy.",
      "properties": {
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "locator_rewrites": {
          "additionalProperties": {
            "$ref": "#/$defs/ControlTarget"
          },
          "description": "step_id -> replacement target",
          "title": "Locator Rewrites",
          "type": "object"
        }
      },
      "required": [
        "tenant_id"
      ],
      "title": "TenantOverlay",
      "type": "object"
    },
    "WaitPolicy": {
      "additionalProperties": false,
      "properties": {
        "appear_ms": {
          "default": 10000,
          "title": "Appear Ms",
          "type": "integer"
        },
        "settle_ms": {
          "default": 150,
          "title": "Settle Ms",
          "type": "integer"
        },
        "retry": {
          "default": 2,
          "title": "Retry",
          "type": "integer"
        }
      },
      "title": "WaitPolicy",
      "type": "object"
    },
    "Witness": {
      "additionalProperties": false,
      "description": "A cheap precondition. Wrong page / drift fails here, not three steps later.",
      "properties": {
        "kind": {
          "enum": [
            "heading",
            "text",
            "url_glob",
            "title"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Witness",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "entry": {
      "$ref": "#/$defs/EntryPoint"
    },
    "parameters": {
      "items": {
        "$ref": "#/$defs/Parameter"
      },
      "title": "Parameters",
      "type": "array"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/OutputSpec"
      },
      "title": "Outputs",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "title": "Steps",
      "type": "array"
    },
    "checkpoint": {
      "$ref": "#/$defs/Checkpoint"
    },
    "handlers": {
      "items": {
        "$ref": "#/$defs/Handler"
      },
      "title": "Handlers",
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/CapabilityPolicy"
    },
    "approval": {
      "default": "draft",
      "enum": [
        "draft",
        "approved"
      ],
      "title": "Approval",
      "type": "string"
    },
    "overlays": {
      "items": {
        "$ref": "#/$defs/TenantOverlay"
      },
      "title": "Overlays",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "entry",
    "parameters",
    "outputs",
    "steps",
    "checkpoint",
    "handlers",
    "policy",
    "metadata"
  ],
  "title": "Capability",
  "type": "object"
}
