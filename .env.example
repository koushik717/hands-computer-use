# Copy to .env (never commit the real file).
# One of these is required for discovery. Replay does not need a model.

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=          # optional OpenAI-compatible endpoint (Groq, Azure, Ollama, ...)
#
# Example (Groq):
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=qwen/qwen3.8-27b

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# HANDS_HEADLESS=1          # default 1. Set 0 to watch the browser.
# PIONEER_PORT=8765
# OPERATOR_PORT=8766
